{% comment %}
  eerste if kijkt naar de map van eigen images
{% endcomment %}

{% if imagesrc contains 'assets/images' %}
  <picture>
    <source
      srcset="{{ imagesrc }}.avif?width={{ width }}&height={{ height }}&quality=70"
      type="image/avif"
    >
    <source
      srcset="{{ imagesrc }}.webp?width={{ width }}&height={{ height }}&quality=70"
      type="image/webp"
    >
    <img
      class="{{ class }}"
      src="{{ imagesrc }}?width={{ width }}&height={{ height }}&quality=60"
      fetchpriority="{{ fetch }}"
      loading="{{ loading }}"
      alt="{{ alt }}"
    >
  </picture>

{% else %}
  {% comment %}
    deze is voor de database van directus
  {% endcomment %}
  <picture>
    <source
      srcset="{{ imagesrc }}?width={{ width }}&height={{ height }}&format=avif&quality=70"
      type="image/avif"
    >
    <source
      srcset="{{ imagesrc }}?width={{ width }}&height={{ height }}&format=webp&quality=70"
      type="image/webp"
    >
    <img
      class="{{ class }}"
      src="{{ imagesrc }}?width={{ width }}&height={{ height }}&quality=60"
      fetchpriority="{{ fetch }}"
      loading="{{ loading }}"
      alt="{{ alt }}"
    >
  </picture>
{% endif %}
