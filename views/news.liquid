{% render 'partials/head.liquid', title: 'nieuws', path: path %}

<section>
  <h1>nieuws</h1>
</section>
<section>
  {% for nieuws in news %}
    <article>
      <section>
        <img>
        <p>{{ nieuws.date }}</p>
      </section>
      <h2>{{ nieuws.title }}</h2>
      <p>{{ nieuws.description }}</p>
    </article>
  {% endfor %}
</section>

{% render 'partials/footer.liquid' %}
