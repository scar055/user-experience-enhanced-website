{% render 'partials/head.liquid', title: 'nieuws', path: path %}

<section>
  <h1>nieuws</h1>

  {% render 'partials/image.liquid',
    imagesrc: 'assets/images/heronews',
    width: '100',
    height: '100',
    alt: 'hero foto',
    fetch: 'auto',
    loading: 'lazy'
  %}
</section>
<section class="news-section">
  {% for nieuws in news %}
    <article>
      <section>
        <img src="assets/images/calendar.svg" alt="calendar icon" loading="lazy" fetchpriority="auto">
        <p>{{ nieuws.date }}</p>
      </section>
      <h2>{{ nieuws.title }}</h2>
      <p>{{ nieuws.description }}</p>
    </article>
  {% endfor %}
</section>

{% render 'partials/footer.liquid' %}
